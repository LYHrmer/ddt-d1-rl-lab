+
+void MujocoRos2ControlPlugin::PublishBaseObservations(const mjData *data)
+{
+  if (!base_pose_publisher_ || !std::isfinite(data->time) || data->time < 0.0) {
+    return;
+  }
+  constexpr double publish_period = 1.0 / 25.0;
+  // Reset can move simulation time backwards without calling the plugin Reset hook.
+  if (last_observation_time_ >= 0.0 && data->time >= last_observation_time_ &&
+      data->time - last_observation_time_ + 1e-9 < publish_period) {
+    return;
+  }
+  last_observation_time_ = data->time;
+  const rclcpp::Time stamp(
+    static_cast<int64_t>(std::llround(data->time * 1e9)), RCL_ROS_TIME);
+  const mjtNum *position = data->xpos + 3 * base_body_id_;
+  const mjtNum *quaternion = data->xquat + 4 * base_body_id_;
+  base_pose_message_.header.stamp = stamp;
+  base_pose_message_.pose.position.x = position[0];
+  base_pose_message_.pose.position.y = position[1];
+  base_pose_message_.pose.position.z = position[2];
+  base_pose_message_.pose.orientation.w = quaternion[0];
+  base_pose_message_.pose.orientation.x = quaternion[1];
+  base_pose_message_.pose.orientation.y = quaternion[2];
+  base_pose_message_.pose.orientation.z = quaternion[3];
+  base_pose_publisher_->publish(base_pose_message_);
+
+  if (base_velocity_publisher_) {
+    const mjtNum *velocity = data->sensordata + base_velocity_adr_;
+    base_velocity_message_.header.stamp = stamp;
+    base_velocity_message_.vector.x = velocity[0];
+    base_velocity_message_.vector.y = velocity[1];
+    base_velocity_message_.vector.z = velocity[2];
+    base_velocity_publisher_->publish(base_velocity_message_);
+  }
 }
 
